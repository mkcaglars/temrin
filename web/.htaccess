DirectoryIndex index.php

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
  # Temrin yalnızca kendi içinde ve okul portalında (iframe) gösterilebilir; başka siteler çerçeveleyemez.
  # PHP sayfalarının kendi CSP başlıklarında frame-ancestors yoktur; çerçeve kuralı yalnızca buradadır.
  Header always unset X-Frame-Options
  Header always set Content-Security-Policy "frame-ancestors 'self' https://portal.mkcaglar.com"
</IfModule>

# Gizli dosyalar (.env vb.) ve kütüphane klasörü doğrudan açılamasın
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^lib/ - [F,L]
  # Hostinger Git ile yayında public_html/.git klasörü oluşur; noktayla başlayan klasör ve dosyalar açılamasın.
  RewriteRule (^|/)\. - [F,L]
</IfModule>
RedirectMatch 404 /\.git
