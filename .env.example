# Bu dosyayı ".env" adıyla web/ klasörünün BİR ÜSTÜNE kopyalayın (web köküne koymayın).
# Hostinger'da: public_html = web/ içeriği, .env = public_html'in yanında.

# Portal ile paylaşılan gizli anahtar (en az 32 karakter). Üretmek için:
#   php -r "echo bin2hex(random_bytes(32));"
PORTAL_SSO_ANAHTAR=

# Veritabanı
DB_DSN=mysql:host=localhost;dbname=temrin;charset=utf8mb4
DB_KULLANICI=
DB_SIFRE=
# Yerel deneme: DB_DSN=sqlite:/tam/yol/temrin.sqlite

# Erişim zamanlarının girildiği ve gösterildiği saat dilimi
SAAT_DILIMI=Europe/Istanbul

# İsteğe bağlı: puan API'sine yalnızca bu IP'lerden izin ver (virgülle)
PORTAL_IP_IZINLI=
