# Bu dosyayı ".env" adıyla web/ klasörünün BİR ÜSTÜNE kopyalayın (web köküne koymayın).
# Hostinger'da: public_html = web/ klasörünün içeriği, .env = public_html'in yanında.

# Portal ile paylaşılan gizli anahtar (en az 32 karakter). Portaldaki TEMRIN_ANAHTAR ile AYNI olmalı.
# Üretmek için:  php -r "echo bin2hex(random_bytes(32));"
PORTAL_SSO_ANAHTAR=

# Veritabanı (MySQL/MariaDB). Tablolar ilk istekte otomatik oluşturulur.
DB_DSN=mysql:host=localhost;dbname=temrin;charset=utf8mb4
DB_KULLANICI=
DB_SIFRE=
# Yerel deneme için: DB_DSN=sqlite:/tam/yol/temrin.sqlite

# Temrin erişim zamanlarının girildiği ve gösterildiği saat dilimi
SAAT_DILIMI=Europe/Istanbul
