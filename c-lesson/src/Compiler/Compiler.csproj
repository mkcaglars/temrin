<Project Sdk="Microsoft.NET.Sdk">
  <!-- Öğrenci kodunu derleyen, denetleyen ve çalıştırmaya hazırlayan kütüphane (tarayıcıda ve testlerde ortak). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CLesson.Compiler</RootNamespace>
    <AssemblyName>CLesson.Compiler</AssemblyName>
    <SatelliteResourceLanguages>tr</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <ProjectReference Include="..\MiniWinForms\MiniWinForms.csproj" />
  </ItemGroup>

  <!-- Öğrenci kodunun derlenebileceği referans derlemeleri. Liste bilinçli olarak kısıtlıdır
       (ağ, yansıma, süreç vb. API'ler dahil edilmez). -->
  <PropertyGroup>
    <StudentReferences>;System.Runtime;System.Collections;System.Collections.NonGeneric;System.Collections.Specialized;System.Console;System.Linq;System.Text.RegularExpressions;System.Runtime.Extensions;System.ComponentModel;System.ComponentModel.Primitives;System.ComponentModel.TypeConverter;System.Drawing.Primitives;System.ObjectModel;System.Threading;System.Threading.Tasks;System.Threading.Thread;System.Runtime.Numerics;System.Memory;System.Text.Encoding.Extensions;System.Globalization;System.IO;System.Diagnostics.Debug;System.Data.Common;System.Xml.ReaderWriter;System.Collections.Immutable;MiniWinForms;</StudentReferences>
  </PropertyGroup>

  <Target Name="EmbedStudentReferences" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <EmbeddedResource Include="@(ReferencePath)" Condition="$(StudentReferences.Contains(';%(Filename);'))" LogicalName="refs/%(Filename).dll" />
    </ItemGroup>
  </Target>
</Project>
