<Project Sdk="Microsoft.NET.Sdk">
  <!-- MySql.Data (Connector/NET) taklidi: komutları tarayıcıdaki MySQL simülatörüne iletir.
       Öğrenci projesine yalnızca "Add Reference > MySql.Data" ya da NuGet ile eklenince derlemeye dahil edilir. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MySql.Data</AssemblyName>
    <RootNamespace>MySql.Data.MySqlClient</RootNamespace>
    <NoWarn>$(NoWarn);CS1591;CA1416;CS0067</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MiniWinForms\MiniWinForms.csproj" />
  </ItemGroup>
</Project>
