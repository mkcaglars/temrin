<Project Sdk="Microsoft.NET.Sdk">
  <!-- Entity Framework 6 (Database First) taklidi: DbContext / DbSet / SaveChanges.
       Kayıtlar MySql.Data üzerinden tarayıcıdaki MySQL simülatörüne yazılır. NuGet ile eklenince derlemeye dahil edilir. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>EntityFramework</AssemblyName>
    <RootNamespace>System.Data.Entity</RootNamespace>
    <NoWarn>$(NoWarn);CS1591;CA1416;CS0067</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MySqlData\MySqlData.csproj" />
    <ProjectReference Include="..\MiniWinForms\MiniWinForms.csproj" />
  </ItemGroup>
</Project>
